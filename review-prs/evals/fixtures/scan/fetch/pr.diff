+
+export function buildRowLabel(a: string, b: string): string {
+  const parts: string[] = [];
+  if (a) {
+    parts.push(a.trim());
+  }
+  if (b) {
+    parts.push(b.trim());
+  }
+  const joined = parts.join(' ');
+  const upper = joined.toUpperCase();
+  const lower = joined.toLowerCase();
+  return upper === lower ? joined : upper;
+}
